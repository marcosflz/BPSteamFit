{
  "name": "bpsteamfit",
  "version": "0.1.0",
  "private": true,
  "description": "Catálogo e instalador local de juegos con experiencia de salón y sincronización segura con Steam",
  "author": "BPSteamFit",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "predev": "npm run native",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "tsx scripts/generate-schema.ts",
    "assets": "tsx scripts/build-assets.ts",
    "native": "tsx scripts/build-native.ts",
    "demo": "tsx scripts/build-demo.ts",
    "gamepack": "tsx src/cli/index.ts",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=cjs --outfile=dist/cli/gamepack.cjs",
    "dist": "npm run native && npm run demo && npm run build && electron-builder --win",
    "dist:dir": "npm run native && npm run demo && npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
