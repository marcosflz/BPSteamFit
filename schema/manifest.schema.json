{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpsteamfit.local/schemas/manifest-v1.schema.json",
  "title": "BPSteamFit .game manifest v1",
  "description": "Manifiesto para paquetes .game. Un .game es un ZIP con manifest.json y payload/. No se admiten scripts, hooks ni comandos de shell.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\d+(?:\\.\\d+){0,3}(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "searchTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "releaseYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "edition": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "providerIds": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "additionalProperties": false
    },
    "installation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "executable"
        },
        "profile": {
          "type": "string",
          "enum": [
            "generic",
            "inno",
            "nsis",
            "demo"
          ]
        },
        "executable": {
          "type": "string"
        },
        "workingDirectory": {
          "type": "string"
        },
        "arguments": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "requiresElevation": {
          "default": false,
          "type": "boolean"
        },
        "successExitCodes": {
          "default": [
            0
          ],
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "rebootRequiredExitCodes": {
          "default": [],
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "verification": {
          "type": "object",
          "properties": {
            "requiredFiles": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requiredDirectories": {
              "default": [],
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "timeoutSeconds": {
              "default": 30,
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "profile",
        "executable",
        "verification"
      ],
      "additionalProperties": false
    },
    "launch": {
      "type": "object",
      "properties": {
        "executable": {
          "type": "string"
        },
        "arguments": {
          "default": [],
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "workingDirectory": {
          "type": "string"
        }
      },
      "required": [
        "executable"
      ],
      "additionalProperties": false
    },
    "steam": {
      "default": {
        "enabled": true,
        "tags": []
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tags": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "installation",
    "launch"
  ],
  "additionalProperties": false
}
